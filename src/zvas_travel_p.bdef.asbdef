projection;
strict ( 2 );

define behavior for ZVAS_TRAVEL_P //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action acceptTravel;
  use action rejectTravel;
  use action cancelTravel;

  use association _Booking { create; }
}

define behavior for ZVAS_BOOKING_P //alias <alias_name>
{

  use update;
  use delete;

  use association _Travel;
}